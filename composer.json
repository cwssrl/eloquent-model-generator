    "autoload": {
        "psr-4": {
            "Cws\\EloquentModelGenerator\\": "src/"
        }
    },
    "require": {
        "illuminate/database": "^6.20.12 || ^7.0 || ^8.0 || ^9.0",
        "illuminate/support": "^6.20.12 || ^7.0 || ^8.0 || ^9.0",
        "illuminate/config": "^6.20.12 || ^7.0 || ^8.0 || ^9.0",
        "illuminate/console": "^6.20.12 || ^7.0 || ^8.0 || ^9.0",
        "doctrine/dbal": "^2.5 || ^3.0",
        "cwssrl/code-generator": "^1.0.4"
    },
    "suggest": {
        "Astrotomic/laravel-translatable": "Allows to configure translation tables"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Cws\\EloquentModelGenerator\\Provider\\GeneratorServiceProvider"
            ]
        }
    }
}
