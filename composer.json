{
    "name": "cwssrl/eloquent-model-generator",
    "description": "Eloquent Model Generator",
    "license": "MIT",
    "authors": [
        {
            "name": "Samuele Salvatico",
            "email": "samuele.salvatico.social@gmail.com",
            "role": "Developer"
        },
        {
            "name": "Andrea Romanello",
            "email": "andrea.romanello@cws.it",
            "role": "Developer"
        }
